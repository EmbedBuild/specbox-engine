# Version control
.git
.github

# Quality logs and evidence (runtime, not build-time)
.quality/logs/
.quality/evidence/

# Dependencies and build artifacts
node_modules
__pycache__
*.pyc
.venv
*.egg-info
dist/

# Secrets
.env
.env.*

# Tests (not needed in production image)
tests/

# The engine's own backlog must never travel in the remote MCP image (UC-3801):
# a remote FreeForm session has no disk mode, and nothing on the server may be
# served as "a board" to a client.
doc/tracking/

# Research and internal prompts
doc/research/
doc/plans/
docs/prompts/

# IDE and editor
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
